<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Error ${status!"500"}</title>
    <link rel="stylesheet" href="/css/wireframe.css">
</head>
<body>
    <section>
        <div>
            <h1>Error ${status!"500"}</h1>
            <p>${message!"An unexpected error occurred."}</p>
            <a href="${backLink}">${backText}</a>
        </div>
    </section>
</body>
</html>